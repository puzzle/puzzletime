- @title ||= ti(:title, model: full_entry_label).html_safe
- receipt = entry.receipt

.row.columns
  .col-12.col-md-6
    = render 'attrs'

    %br/
    .hidden-xs.hidden-sm
      = render 'backlink'
      = render 'actions_show'

  .col-12.col-md-6
    = render 'attachment_display', receipt: receipt

    .hidden-md.hidden-lg.hidden-xl
      = render 'backlink'
      = render 'actions_show'
