-# Rows start hidden (Tailwind's `hidden`); the .planning-details-toggle click handler in plannings.js toggles it.
-# The first row's id is the toggle's href target (aria only).
- board.detail_rows.each_with_index do |(label, percents), index|
  %tr.planning-details.hidden{ class: "planning-details-#{board.employee.id}",
                                 id: index.zero? ? "planning-details-#{board.employee.id}" : nil }
    %td.head.small.planning-name{ title: label }
      %span.planning-name-label= label
    - @period.step(7) do |date|
      - value = percents[date].to_f
      %td{ class: ('planning-details-value' if value.nonzero?) }= value.nonzero? ? value.round : nil
