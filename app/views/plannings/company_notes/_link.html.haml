- filled = employee.planning_note.present?
- lines = employee.planning_note.to_s.lines

= link_to plannings_company_note_path(employee),
          class: 'planning-note-link',
          title: filled ? nil : 'Notiz erfassen',
          data: { modal: '#modal', title: "Notiz: #{employee.label}", remote: true, type: :html } do
  = icon(:comment, class: filled ? 'planning-note-icon has-note' : 'planning-note-icon')
-# sibling of the link, not a child: links in the rendered markdown would otherwise nest <a> tags,
-# which makes the HTML parser close the outer link early and move the preview out of it
- if filled
  .planning-note-preview
    .planning-note-markdown
      = planning_note_markdown(lines.first(10).join)
      - if lines.size > 10
        %p …
