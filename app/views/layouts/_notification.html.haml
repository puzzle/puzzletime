- if @notifications && !@notifications.empty?
  #notifications.alert.alert-info
    %a.close{:'data-dismiss' => 'alert', :href => '#'} &times;
    %ul
      - @notifications.each do |notification|
        %li
          = safe_join(notification.message.split("\n"), tag.br)
          - if notification.cta_url.present?
            = link_to notification.cta_text.presence || t('user_notifications.cta_default'), notification.cta_url, class: 'btn btn-primary btn-xs'
