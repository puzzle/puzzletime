#!/usr/bin/env ruby
# frozen_string_literal: true

# Lints commit subjects against the rules overcommit enforces locally, so CI
# catches messages authored without the git hooks.
#
# Single source of truth: both the Conventional Commits regex
# (CommitMsg/MessageFormat/pattern) and the subject cap
# (CommitMsg/TextWidth/max_subject_width) are read from .overcommit.yml —
# keep the rules in one place.
#
# Usage:
#   bin/commit-lint                       # lints origin/master..HEAD
#   bin/commit-lint <range>               # e.g. main..HEAD
#   bin/commit-lint <base-sha> <head-sha> # as passed by CI

require 'yaml'

overcommit = YAML.load_file(File.expand_path('../.overcommit.yml', __dir__))
pattern = overcommit.dig('CommitMsg', 'MessageFormat', 'pattern')
abort 'No CommitMsg/MessageFormat/pattern in .overcommit.yml' unless pattern
regex = Regexp.new(pattern)
max_width = overcommit.dig('CommitMsg', 'TextWidth', 'max_subject_width')
abort 'No CommitMsg/TextWidth/max_subject_width in .overcommit.yml' unless max_width

range =
  case ARGV.length
  when 0 then 'origin/master..HEAD'
  when 1 then ARGV[0]
  else "#{ARGV[0]}..#{ARGV[1]}"
  end

log = `git log --format=%H%x09%s #{range}`
abort "git log failed for range: #{range}" unless $?.success?

offenders = log.lines.filter_map do |line|
  sha, subject = line.chomp.split("\t", 2)
  next if subject.nil?

  reasons = []
  reasons << 'not Conventional Commits' unless regex.match?(subject)
  reasons << "subject is #{subject.length} chars, max #{max_width}" if subject.length > max_width
  next if reasons.empty?

  "#{sha[0, 8]}  #{subject}\n            #{reasons.join('; ')}"
end

if offenders.empty?
  puts "commit-lint: all commit subjects in #{range} are well-formed " \
       "(Conventional Commits, <= #{max_width} chars)"
  exit 0
end

warn "commit-lint: #{offenders.size} commit(s) violate the commit message rules:"
offenders.each { |o| warn "  #{o}" }
warn ''
warn 'Expected e.g. "feat(scope): summary" — see CONTRIBUTING.md#commit-messages'
exit 1
